---
import Uklad from '../layouts/Uklad.astro';
import Zdjecie from '../components/Zdjecie.astro';
import Marka from '../components/Marka.astro';
import Ikona from '../components/Ikona.astro';
import Formularz from '../components/Formularz.astro';
import { strona } from '../data/strona';

// Opcje listy „Wybierz interesujące Cię szkolenie” (jak na obecnej stronie).
// Przyciski „Zapisz się na szkolenie” zaznaczają od razu właściwą pozycję (data-wybierz).
const szkolenia = {
  ocenianie: 'Ocenianie kształtujące',
  jednaKlasa: 'Jedna klasa – wiele potrzeb',
  podstawa: 'Nowa podstawa programowa w praktyce przedszkolnej i wczesnoszkolnej',
  zmiana: 'Od wyzwania do zmiany',
  rodzic: 'Co każdy rodzic powinien wiedzieć?',
};

const adresStrony = `${strona.adresStrony}/szkolenia`;
const organizacja = { '@id': `${strona.adresStrony}/#organizacja` };
const kursy = [
  {
    id: 'ocenianie-ksztaltujace',
    nazwa: szkolenia.ocenianie,
    opis: 'Budowanie przestrzeni na osiąganie przez uczniów celów edukacyjnych.',
    czas: 'PT3H',
  },
  {
    id: 'jedna-klasa',
    nazwa: szkolenia.jednaKlasa,
    opis: 'Praca z klasą różnorodną i profilaktyka wypalenia zawodowego nauczyciela.',
    czas: 'PT3H',
  },
  {
    id: 'nowa-podstawa',
    nazwa: szkolenia.podstawa,
    opis: 'Rozwijanie kompetencji fundamentalnych, przekrojowych i sprawczości dzieci.',
    czas: 'PT3H',
  },
  {
    id: 'od-wyzwania-do-zmiany',
    nazwa: szkolenia.zmiana,
    opis: 'Określanie celów szkoły/przedszkola na podstawie wniosków z nadzoru i planowanie pracy w oparciu o grę coachingową Heros Navigares® – Podróż Bohatera®.',
    czas: 'PT4H',
  },
];
const daneStrukturalne = kursy.map((kurs) => ({
  '@type': 'Course',
  '@id': `${adresStrony}#${kurs.id}`,
  url: `${adresStrony}#${kurs.id}`,
  name: kurs.nazwa,
  description: kurs.opis,
  inLanguage: 'pl-PL',
  timeRequired: kurs.czas,
  provider: organizacja,
}));
---

<Uklad
  tytul="Szkolenia stacjonarne w Twojej placówce"
  opis="Szkolenia stacjonarne w Twojej placówce: ocenianie kształtujące, praca z klasą różnorodną, nowa podstawa programowa i gra coachingowa „Podróż Bohatera”®."
  zdjecieOg="szkolenie-sala.jpg"
  pasekKontaktu={false}
  daneStrukturalne={daneStrukturalne}
>
  <!-- Tytuł strony i karty szkoleń (dawniej wSection_49) -->
  <section class="sekcja otwarcie" aria-labelledby="szkolenia-tytul">
    <div class="kontener">
      <header class="tytul-strony" data-pokaz>
        <h1 id="szkolenia-tytul">SZKOLENIA STACJONARNE W TWOJEJ PLACÓWCE</h1>
      </header>

      <nav class="karty-szkolen" aria-label="Szkolenia na tej stronie">
        <ul class="karty-szkolen__lista">
          <li class="karta karta-szkolenia" data-pokaz>
            <p class="karta-szkolenia__tytul">OCENIANIE KSZTAŁTUJĄCE.</p>
            <p class="karta-szkolenia__opis">BUDOWANIE PRZESTRZENI NA OSIĄGANIE PRZEZ UCZNIÓW CELÓW EDUKACYJNYCH.</p>
            <div class="przyciski">
              <a class="przycisk przycisk--obrys" href="#ocenianie-ksztaltujace">Dowiedz się więcej<span class="sr-only"> o szkoleniu „Ocenianie kształtujące”</span><Ikona nazwa="strzalka" class="w-dol" /></a>
            </div>
          </li>
          <li class="karta karta-szkolenia" data-pokaz style="--opoznienie: 0.08s">
            <p class="karta-szkolenia__tytul">JEDNA KLASA – WIELE POTRZEB.</p>
            <p class="karta-szkolenia__opis">PRACA Z KLASĄ RÓŻNORODNĄ I PROFILAKTYKA WYPALENIA ZAWODOWEGO NAUCZYCIELA.</p>
            <div class="przyciski">
              <a class="przycisk przycisk--obrys" href="#jedna-klasa">Dowiedz się więcej<span class="sr-only"> o szkoleniu „Jedna klasa – wiele potrzeb”</span><Ikona nazwa="strzalka" class="w-dol" /></a>
            </div>
          </li>
          <li class="karta karta-szkolenia" data-pokaz style="--opoznienie: 0.16s">
            <p class="karta-szkolenia__tytul">NOWA PODSTAWA PROGRAMOWA W PRAKTYCE PRZEDSZKOLNEJ I WCZESNOSZKOLNEJ.</p>
            <p class="karta-szkolenia__opis">ROZWIJANIE KOMPETENCJI FUNDAMENTALNYCH, PRZEKROJOWYCH I SPRAWCZOŚCI DZIECI</p>
            <div class="przyciski">
              <a class="przycisk przycisk--obrys" href="#nowa-podstawa">Dowiedz się więcej<span class="sr-only"> o szkoleniu „Nowa podstawa programowa w praktyce przedszkolnej i wczesnoszkolnej”</span><Ikona nazwa="strzalka" class="w-dol" /></a>
            </div>
          </li>
          <li class="karta karta-szkolenia" data-pokaz style="--opoznienie: 0.24s">
            <p class="karta-szkolenia__tytul">OD WYZWANIA DO ZMIANY</p>
            <p class="karta-szkolenia__opis">OKREŚLANIE CELÓW SZKOŁY/PRZEDSZKOLA NA PODSTAWIE WNIOSKÓW Z NADZORU I PLANOWANIE PRACY W OPARCIU O GRĘ COACHINGOWĄ HEROS NAVIGARES® – PODRÓŻ BOHATERA®</p>
            <div class="przyciski">
              <a class="przycisk przycisk--obrys" href="#od-wyzwania-do-zmiany">Dowiedz się więcej<span class="sr-only"> o szkoleniu „Od wyzwania do zmiany”</span><Ikona nazwa="strzalka" class="w-dol" /></a>
            </div>
          </li>
        </ul>
      </nav>
    </div>
  </section>

  <!-- Podejście do szkoleń (dawniej wSection_52) -->
  <section class="sekcja sekcja--piasek podejscie">
    <div class="kontener">
      <div class="podejscie__uklad">
        <div class="podejscie__tekst" data-pokaz>
          <p class="podejscie__teza"><em><strong>KAŻDY SCENARIUSZ SZKOLENIA TWORZĘ OSOBIŚCIE, DBAJĄC O JEGO REALNE OSADZENIE W CODZIENNOŚCI POLSKIEJ SZKOŁY.</strong></em></p>
          <p class="podejscie__opis"><em>PRACUJĘ W OPARCIU O AKTUALNE BADANIA EDUKACYJNE (EVIDENCE‑BASED), NOWOCZESNE TRENDY W EDUKACJI ORAZ TO, CO DZIŚ JEST NAPRAWDĘ KLUCZOWE DLA NAUCZYCIELI I UCZNIÓW — ICH DOBROSTAN, SPRAWCZOŚĆ I SENS UCZENIA SIĘ.</em></p>
        </div>
        <div class="podejscie__zdjecie" data-pokaz style="--opoznienie: 0.15s">
          <Zdjecie
            plik="portret-czarny-stroj.jpg"
            alt="Portret Izabeli Knul w czarnym stroju, uśmiechniętej, z okularami w uniesionej dłoni, na gładkim szarobrązowym tle"
            sizes="(min-width: 52rem) 26rem, (min-width: 30rem) 24rem, calc(100vw - 2.5rem)"
            proporcje="3 / 4"
            kadr="50% 30%"
          />
        </div>
      </div>

      <div class="podejscie__haslo wycentrowane" data-pokaz>
        <p class="haslo">ŁĄCZĘ RZETELNĄ MERYTORYKĘ Z PRAKTYKĄ SZKOLNĄ, UWAŻNOŚCIĄ NA LUDZI I DBAŁOŚCIĄ O PROCES</p>
      </div>
    </div>
  </section>

  <!-- Szkolenie 1: Ocenianie kształtujące (dawniej wSection_54) -->
  <section class="sekcja szkolenie" id="ocenianie-ksztaltujace" aria-labelledby="ocenianie-ksztaltujace-tytul">
    <div class="kontener">
      <div class="szkolenie__gora">
        <div class="szkolenie__zdjecie" data-pokaz>
          <Zdjecie
            plik="szkolenie-ocenianie-ksztaltujace.jpg"
            alt="Uczestniczka szkolenia zaznacza zielonym zakreślaczem kolorowe owale na arkuszu ćwiczeniowym – praca warsztatowa z ocenianiem kształtującym"
            sizes="(min-width: 75rem) 33rem, (min-width: 52rem) 45vw, calc(100vw - 2.5rem)"
            proporcje="4 / 3"
            kadr="45% 45%"
          />
        </div>
        <div class="szkolenie__tresc" data-pokaz style="--opoznienie: 0.1s">
          <h2 id="ocenianie-ksztaltujace-tytul" class="szkolenie__tytul">OCENIANIE KSZTAŁTUJĄCE.</h2>
          <p class="szkolenie__podtytul">BUDOWANIE PRZESTRZENI NA OSIĄGANIE PRZEZ UCZNIÓW CELÓW EDUKACYJNYCH.</p>
          <h3 class="szkolenie__korzysci">Co zyskasz dzięki udziałowi w szkoleniu?</h3>
          <ul class="lista">
            <li>Nauczysz się formułować cele lekcji w języku zrozumiałym dla uczniów.</li>
            <li>Stworzysz jasne i sprawdzalne kryteria sukcesu, które realnie wspierają uczenie się.</li>
            <li>Uporządkujesz sposób udzielania informacji zwrotnej tak, by była wspierająca i zgodna z ideą oceniania kształtującego.</li>
            <li>Wypracujesz konkretne rozwiązania obejmujące wszystkie pięć strategii oceniania kształtującego.</li>
            <li>Opracujesz realny plan wdrażania oceniania kształtującego we współpracy z innymi nauczycielami.</li>
          </ul>
          <dl class="metryczka">
            <div><dt>Dla kogo?</dt><dd>nauczyciele wszystkich etapów edukacyjnych</dd></div>
            <div><dt>Czas trwania:</dt><dd>3 godziny zegarowe</dd></div>
            <div><dt>Miejsce realizacji:</dt><dd>Twoja placówka lub <a href="/czas-do-lasu"><Marka /></a></dd></div>
          </dl>
        </div>
      </div>

      <div class="szkolenie__dol" data-pokaz>
        <p>Ocenianie kształtujące (formative assessment) to podejście do oceniania, z którym pracuję na co dzień, ponieważ realnie <strong>wspiera uczenie się w trakcie jego trwania (także uczenie się dorosłych!)</strong>, a nie tylko je podsumowuje. Podczas szkolenia pokazuję, jak świadomie zbierać informacje o postępach uczniów i wykorzystywać je do planowania procesu uczenia się.</p>
        <p>Na spotkaniu pracujemy intensywnie i warsztatowo, także z wykorzystaniem <strong>własnych materiałów nauczycieli</strong>, aby wypracowane rozwiązania były możliwe do zastosowania od razu w codziennej praktyce.</p>
        <div class="przyciski">
          <a class="przycisk" href="#zapisy" data-wybierz={szkolenia.ocenianie}>Zapisz się na szkolenie<span class="sr-only"> „Ocenianie kształtujące”</span><Ikona nazwa="strzalka" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Szkolenie 2: Jedna klasa – wiele potrzeb (dawniej wSection_56) -->
  <section class="sekcja sekcja--piasek szkolenie szkolenie--odwrotnie" id="jedna-klasa" aria-labelledby="jedna-klasa-tytul">
    <div class="kontener">
      <div class="szkolenie__gora">
        <div class="szkolenie__zdjecie" data-pokaz>
          <Zdjecie
            plik="szkolenie-jedna-klasa.jpg"
            alt="Prowadząca w zielonym żakiecie pochyla się nad stolikiem i rozmawia z uczestniczkami szkolenia dla nauczycieli"
            sizes="(min-width: 75rem) 33rem, (min-width: 52rem) 45vw, calc(100vw - 2.5rem)"
            proporcje="4 / 3"
            kadr="40% 50%"
          />
        </div>
        <div class="szkolenie__tresc" data-pokaz style="--opoznienie: 0.1s">
          <h2 id="jedna-klasa-tytul" class="szkolenie__tytul">JEDNA KLASA – WIELE POTRZEB.</h2>
          <p class="szkolenie__podtytul">JAK PRACOWAĆ Z KLASĄ RÓŻNORODNĄ I NIE WYPALIĆ SIĘ JAKO NAUCZYCIEL?</p>
          <h3 class="szkolenie__korzysci">Co zyskasz dzięki udziałowi w szkoleniu?</h3>
          <ul class="lista">
            <li>Zidentyfikujesz i uporządkujesz potrzeby swojej klasy, aby skuteczniej planować pracę dydaktyczną.</li>
            <li>Dobierzesz strategie pracy adekwatne do różnorodnych potrzeb uczniów.</li>
            <li>Zaprojektujesz rutyny i zasady, które zwiększą przewidywalność, bezpieczeństwo i efektywność lekcji.</li>
            <li>Nauczysz się rozpoznawać własne sygnały przeciążenia i dobierać konkretne działania wspierające Twój dobrostan.</li>
            <li>Zaplanujesz współpracę z innymi nauczycielami jako realny system wsparcia i przeciwdziałania wypaleniu.</li>
          </ul>
          <dl class="metryczka">
            <div><dt>Dla kogo?</dt><dd>nauczyciele wszystkich poziomów edukacyjnych</dd></div>
            <div><dt>Czas trwania:</dt><dd>3 godziny zegarowe</dd></div>
            <div><dt>Miejsce realizacji:</dt><dd>Twoja placówka lub <a href="/czas-do-lasu"><Marka /></a></dd></div>
          </dl>
        </div>
      </div>

      <div class="szkolenie__dol" data-pokaz>
        <p>To szkolenie pomaga odzyskać <strong>poczucie wpływu i sprawczości</strong>, uczy działać w oparciu o priorytety i pokazuje, że <strong>dbanie o siebie nie jest dodatkiem do pracy nauczyciela, ale podstawą jej jakości.</strong></p>
        <p>Podczas spotkania porządkujemy pracę dydaktyczną: budujemy strukturę, rutyny i zasady, które dają bezpieczeństwo uczniom, a nauczycielowi zdejmują część codziennego napięcia. Równolegle przyglądamy się temu, co dzieje się z nauczycielem – jego zasobom, granicom i sygnałom przeciążenia. Kluczowym elementem jest tu <strong>profilaktyka wypalenia zawodowego</strong>.</p>
        <p>Pracujemy w oparciu o <strong>realne sytuacje z klas</strong>, tak aby każdy mógł wyjść z <strong>konkretnymi rozwiązaniami dopasowanymi do swojej grupy.</strong></p>
        <div class="przyciski">
          <a class="przycisk" href="#zapisy" data-wybierz={szkolenia.jednaKlasa}>Zapisz się na szkolenie<span class="sr-only"> „Jedna klasa – wiele potrzeb”</span><Ikona nazwa="strzalka" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Szkolenie 3: Nowa podstawa programowa (dawniej wSection_57) -->
  <section class="sekcja szkolenie" id="nowa-podstawa" aria-labelledby="nowa-podstawa-tytul">
    <div class="kontener">
      <div class="szkolenie__gora">
        <div class="szkolenie__zdjecie" data-pokaz>
          <Zdjecie
            plik="szkolenie-sala.jpg"
            alt="Prowadząca przy flipcharcie z napisem „UCZUCIA” podczas szkolenia w sali konferencyjnej pełnej uczestników"
            sizes="(min-width: 75rem) 33rem, (min-width: 52rem) 45vw, calc(100vw - 2.5rem)"
            proporcje="4 / 3"
            kadr="40% 60%"
          />
        </div>
        <div class="szkolenie__tresc" data-pokaz style="--opoznienie: 0.1s">
          <h2 id="nowa-podstawa-tytul" class="szkolenie__tytul">NOWA PODSTAWA PROGRAMOWA W PRAKTYCE PRZEDSZKOLNEJ I WCZESNOSZKOLNEJ</h2>
          <p class="szkolenie__podtytul">ROZWIJANIE KOMPETENCJI FUNDAMENTALNYCH, PRZEKROJOWYCH I SPRAWCZOŚCI DZIECI</p>
          <h3 class="szkolenie__korzysci">Co zyskasz dzięki udziałowi w szkoleniu?</h3>
          <ul class="lista">
            <li>Zrozumiesz założenia nowej podstawy programowej wychowania przedszkolnego.</li>
            <li>Nauczysz się interpretować zapisy podstawy w odniesieniu do własnej praktyki.</li>
            <li>Zaprojektujesz doświadczenia edukacyjne wspierające rozwój dzieci, także tych ze specjalnymi potrzebami edukacyjnymi.</li>
            <li>Będziesz stosować cele w języku dziecka, adekwatne kryteria sukcesu i informację zwrotną.</li>
            <li>Stworzysz środowisko sprzyjające sprawczości i dobrostanowi dziecka.</li>
            <li>Zaplanujesz pracę w oparciu o kompetencje fundamentalne, przekrojowe i sprawczość dziecka, zgodnie z nową podstawą programową.</li>
          </ul>
          <dl class="metryczka">
            <div><dt>Dla kogo?</dt><dd>nauczyciele przedszkoli i edukacji wczesnoszkolnej</dd></div>
            <div><dt>Czas trwania:</dt><dd>3 godziny zegarowe</dd></div>
            <div><dt>Miejsce realizacji:</dt><dd>Twoja placówka lub <a href="/czas-do-lasu"><Marka /></a></dd></div>
          </dl>
        </div>
      </div>

      <div class="szkolenie__dol" data-pokaz>
        <p>Pokazuję, jak myśleć o planowaniu w <strong>kategoriach kompetencji (fundamentalnych, przekrojowych), doświadczeń edukacyjnych i sprawczości dziecka</strong>, a nie wyłącznie realizacji treści podstawy programowej.</p>
        <p>Skupiam się na sensownym przełożeniu zapisów dokumentu na codzienne decyzje nauczyciela. Pracujemy nad tym, co z <strong>podstawy programowej</strong> naprawdę wynika dla dziecka, nauczyciela i organizacji pracy w przedszkolu i w szkole.</p>
        <p>Podczas pracy warsztatowej wspieram nauczycieli w projektowaniu realnych rozwiązań do swojej praktyki – od formułowania celów w języku dziecka, przez dobór kryteriów sukcesu i informacji zwrotnej, po <strong>budowanie środowiska sprzyjającego rozwojowi i dobrostanowi.</strong></p>
        <div class="przyciski">
          <a class="przycisk" href="#zapisy" data-wybierz={szkolenia.podstawa}>Zapisz się na szkolenie<span class="sr-only"> „Nowa podstawa programowa w praktyce przedszkolnej i wczesnoszkolnej”</span><Ikona nazwa="strzalka" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Szkolenie 4: Od wyzwania do zmiany (dawniej wSection_58) -->
  <section class="sekcja sekcja--piasek szkolenie szkolenie--odwrotnie" id="od-wyzwania-do-zmiany" aria-labelledby="od-wyzwania-do-zmiany-tytul">
    <div class="kontener">
      <div class="szkolenie__gora">
        <div class="szkolenie__zdjecie" data-pokaz>
          <Zdjecie
            plik="szkolenie-podroz-bohatera.jpg"
            alt="Elementy gry coachingowej „Podróż Bohatera” na stole w lesie: drewniany model żaglowca i kostka z pytaniem „Czego nie chcę usłyszeć?”"
            sizes="(min-width: 75rem) 33rem, (min-width: 52rem) 45vw, calc(100vw - 2.5rem)"
            proporcje="4 / 3"
            kadr="45% 60%"
          />
        </div>
        <div class="szkolenie__tresc" data-pokaz style="--opoznienie: 0.1s">
          <h2 id="od-wyzwania-do-zmiany-tytul" class="szkolenie__tytul">OD WYZWANIA DO ZMIANY.</h2>
          <p class="szkolenie__podtytul">JAK Z UWAŻNOŚCIĄ PODSUMOWAĆ DZIAŁANIA I ZAPLANOWAĆ KOLEJNY KROK ZESPOŁU?</p>
          <h3 class="szkolenie__korzysci">Co zyskasz dzięki udziałowi w szkoleniu?</h3>
          <ul class="lista">
            <li>Skonkretyzujesz cel i określisz wizję zmiany, nad którą pracuje Twój zespół.</li>
            <li>Odniesiesz się do wartości – swoich oraz wartości organizacji – i sprawdzisz, jak są obecne w codziennej praktyce.</li>
            <li>Przyjrzysz się zasobom zespołu i zobaczysz, kto, w jakim obszarze i w jaki sposób może wspierać proces zmiany.</li>
            <li>Nazwiesz to, co utrudnia osiągnięcie celu, i poszukasz sposobów, by przekuć trudności w realny zasób.</li>
            <li>Zaplanujesz strategię osiągnięcia celu: działania, sojuszników i kolejność kroków.</li>
            <li>Zainicjujesz lub realnie wprowadzisz zmianę w swojej organizacji.</li>
            <li>Nauczysz się prostych sposobów dbania o własny dobrostan w codziennej pracy szkolnej.</li>
          </ul>
          <dl class="metryczka">
            <div><dt>Dla kogo?</dt><dd>rady pedagogiczne, zespoły liderów</dd></div>
            <div><dt>Czas trwania:</dt><dd>4 godziny zegarowe</dd></div>
            <div><dt>Miejsce realizacji:</dt><dd>Twoja placówka edukacyjna</dd></div>
          </dl>
        </div>
      </div>

      <div class="szkolenie__dol" data-pokaz>
