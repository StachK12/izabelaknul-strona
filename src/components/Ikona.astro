---
// Proste ikony SVG (bez zewnętrznych bibliotek).
interface Props {
  nazwa: 'facebook' | 'instagram' | 'linkedin' | 'telefon' | 'pinezka' | 'strzalka' | 'menu' | 'zamknij' | 'kalendarz' | 'email';
  class?: string;
}
const { nazwa, class: klasa } = Astro.props;
---

<svg class={klasa} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {nazwa === 'facebook' && <path d="M14 8h2.5V4.5H14A3.5 3.5 0 0 0 10.5 8v2.5H8V14h2.5v6.5H14V14h2.5l.5-3.5h-3V8.5c0-.3.2-.5.5-.5Z" />}
  {nazwa === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.3" cy="6.7" r=".6" fill="currentColor" />
    </>
  )}
  {nazwa === 'linkedin' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="3" />
      <path d="M8 10.5V16M8 7.5v.01M11.5 16v-5.5M11.5 13c0-1.6 1-2.5 2.3-2.5S16 11.4 16 13v3" />
    </>
  )}
  {nazwa === 'telefon' && <path d="M5 4h3.5l1.5 4-2 1.5a11 11 0 0 0 6.5 6.5l1.5-2 4 1.5V19a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z" />}
  {nazwa === 'pinezka' && (
    <>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" />
      <circle cx="12" cy="10" r="2.3" />
    </>
  )}
  {nazwa === 'strzalka' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {nazwa === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {nazwa === 'zamknij' && <path d="M6 6l12 12M18 6 6 18" />}
  {nazwa === 'kalendarz' && (
    <>
      <rect x="3.5" y="5" width="17" height="15.5" rx="2.5" />
      <path d="M3.5 10h17M8 3v4M16 3v4" />
    </>
  )}
  {nazwa === 'email' && (
    <>
      <rect x="3.5" y="5.5" width="17" height="13" rx="2.5" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
</svg>
